<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Reminders on the minute (ADR-107). Granted at install, but Play allows it only for alarm and calendar apps, so only
        the personal build asks; the play build uses SCHEDULE_EXACT_ALARM, which the user allows in Settings.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <!-- Live camera on the Snapdragon's NPU (ADR-115): QNN reaches it through the vendor's FastRPC library. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    </application>
</manifest>
