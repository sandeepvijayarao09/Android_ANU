<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: plain HTTP to the Mac's test MCP server, UCP store and A2A agent (scripts/dev-mock-*.py), which
    the emulator reaches at 10.0.2.2, and to agents on the user's network by their .local names. Release builds allow no cleartext at all. Tokens are never sent over
    HTTP either way: the vault refuses (§11).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Agents on the user's own network, named as devices name themselves there: raspberrypi.local (ADR-105). -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
