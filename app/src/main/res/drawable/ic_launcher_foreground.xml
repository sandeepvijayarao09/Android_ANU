<?xml version="1.0" encoding="utf-8"?>
<!-- Anu's launcher icon: the pearl sphere on a quiet gray page (DESIGN.md, First five seconds). No green or orange,
     which mean data location. The sphere sits inside the adaptive icon's 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A soft shadow beneath, so the sphere rests on the page. -->
    <path android:pathData="M54 83m-19 0a19 4.2 0 1 0 38 0a19 4.2 0 1 0 -38 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="83" android:gradientRadius="19"
                android:startColor="#33000000" android:endColor="#00000000" />
        </aapt:attr>
    </path>
    <!-- The pearl: lit from the upper left, cool at its edge. -->
    <path android:pathData="M54 52m-27 0a27 27 0 1 0 54 0a27 27 0 1 0 -54 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="44" android:centerY="40" android:gradientRadius="40">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FFE9EAF0" />
                <item android:offset="0.8" android:color="#FFC4C7D3" />
                <item android:offset="1" android:color="#FFA9ADBD" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- A faint glass rim. -->
    <path android:pathData="M54 52m-26.4 0a26.4 26.4 0 1 0 52.8 0a26.4 26.4 0 1 0 -52.8 0"
        android:strokeWidth="0.8" android:strokeColor="#40FFFFFF" />
    <!-- The highlight. -->
    <path android:pathData="M45 41m-9 0a9 6.5 0 1 0 18 0a9 6.5 0 1 0 -18 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="45" android:centerY="41" android:gradientRadius="9"
                android:startColor="#CCFFFFFF" android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
