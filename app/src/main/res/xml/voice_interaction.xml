    android:recognitionService="io.github.sandeepvijayarao09.anu.AnuRecognitionService"
    android:sessionService="io.github.sandeepvijayarao09.anu.AnuSessionService"
    android:settingsActivity="io.github.sandeepvijayarao09.anu.MainActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
