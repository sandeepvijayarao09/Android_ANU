<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Debug builds may reach the Mac's test servers over plain HTTP (see the config). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: adb summons the assistant with a question, as "Hey Anu" does. DUMP keeps other apps out. -->
        <receiver
            android:name=".DebugAsk"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: adb speaks for the emulator, whose recognizer has no English pack (ShellSpeech). -->
        <receiver
            android:name=".DebugVoice"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: adb adds an agent on the user's network (ADR-105). DUMP keeps other apps out. -->
        <receiver
            android:name=".DebugA2a"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: adb pairs the user's Mac (ADR-113). DUMP keeps other apps out. -->
        <receiver
            android:name=".DebugMac"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: adb downloads and tries Gemini Nano for AI Writing (ADR-116). DUMP keeps other apps out. -->
        <receiver
            android:name=".DebugNano"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Debug builds only: adb opens live camera on a chosen backend to compare them (ADR-115). DUMP keeps other apps out. -->
        <activity
            android:name=".LiveCameraActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:replace="android:exported" />
    </application>
</manifest>
