<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: plain HTTP to the Mac's test MCP server and UCP store (scripts/dev-mock-*.py), which
    the emulator reaches at 10.0.2.2. Release builds allow no cleartext at all. Tokens are never sent over
    HTTP either way: the vault refuses (§11).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
