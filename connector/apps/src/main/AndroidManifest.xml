<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The apps an app task can open: those with a launcher icon (package visibility, API 30+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Off until the user turns it on in Android's accessibility settings (ADR-098). -->
        <service
            android:name=".AnuAccessibilityService"
            android:exported="true"
            android:label="@string/apps_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/anu_app_control" />
        </service>
    </application>
</manifest>
